<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAMERA e INTERNET já vêm do manifest do SDK. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.Exemplo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PessoasActivity"
            android:exported="false" />

        <activity
            android:name=".CadastroFaceActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Exemplo.Fullscreen" />

        <activity
            android:name=".ReconhecimentoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Exemplo.Fullscreen" />
    </application>

</manifest>
