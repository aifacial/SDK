<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID da empresa" />

        <EditText
            android:id="@+id/edEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ex.: C44BF9"
            android:inputType="text"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Token mobile (painel → Credenciais)" />

        <EditText
            android:id="@+id/edToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Token da empresa (painel → Empresas)" />

        <EditText
            android:id="@+id/edTokenEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/ckLiveness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Prova de vida (pedir ações)" />

        <CheckBox
            android:id="@+id/ckAuditoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auditoria (enviar foto de cada reconhecimento)" />

        <TextView
            android:id="@+id/lbAuditoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btPreparar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Preparar (baixar IA e sincronizar)" />

        <Button
            android:id="@+id/btBaixarIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Só baixar a IA" />

        <Button
            android:id="@+id/btSincronizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Só sincronizar pessoas" />

        <EditText
            android:id="@+id/edIds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="IDs das pessoas, separados por vírgula"
            android:importantForAutofill="no"
            android:inputType="text" />

        <Button
            android:id="@+id/btSincLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sincronizar só estas pessoas" />

        <Button
            android:id="@+id/btApagarPessoas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apagar pessoas do aparelho (manter IA)" />

        <ProgressBar
            android:id="@+id/progresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/lbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btReconhecer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Reconhecimento facial" />

        <Button
            android:id="@+id/btCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastro de faces (login do painel)" />

        <Button
            android:id="@+id/btLimpar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Apagar dados do SDK neste aparelho" />

        <TextView
            android:id="@+id/lbVersao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
